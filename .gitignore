# Environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets
.env
.env.*
!.env.example

# User-saved search artifacts
results/

# LanceDB on-disk datasets (created by the search layer)
lance_data/
lance_data_test/

# Evaluation harness output (SQLite ledger + JSON/CSV reports)
eval_output/

# Logging output (crash files + rotated app log)
crashes/
*.log
*.log.*.gz

# Test documents for manual ingestion smoke tests (PDFs, JATS XML, etc.)
test_documents/

# Benchmark eval corpora — ignored wholesale for now (each holds a
# regenerable lancedb/ + figures/ plus possibly large/licensed docs).
# When ready to SHIP a benchmark, replace this blanket rule with
# selective ones: keep corpus.toml + documents/ + gold.json, ignore
# only benchmarks/*/lancedb/ and benchmarks/*/figures/ (.ka_session.json is
# already covered by the global rule below).
benchmarks/

# Per-corpus GUI session-resume sidecar written next to corpus.toml
# (<corpus>/.ka_session.json) — transient per-user UI state (last ingest-draft
# config + selections). Never commit it, not even with a shipped/gold corpus,
# so ignore it everywhere.
.ka_session.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
