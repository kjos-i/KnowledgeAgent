# Copy this file to .env and fill in real values.
# Never commit your real .env. It is listed in .gitignore.
#
# Only the four DB connection values are truly required (no safe default).
# API keys are needed only for the provider(s) you actually use, and are
# validated lazily at first call (see the API keys section). Everything else
# is optional: the commented lines show each setting's DEFAULT. Uncomment and
# edit only the ones you want to change.
#
# config.py (the Settings class) is the single source of truth for every
# value, its type, and its full description. This file mirrors it.


# ============================================================
# REQUIRED - Knowledge graph (Neo4j)
# ============================================================
#
# NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD have NO safe default. Forcing an
# explicit value removes the "forgot to set it, silently used a default, wrote
# to the wrong place" failure mode.
#
# Test-instance isolation: keep a parallel .env.test file in the same folder.
# It declares the SAME required keys but points at a DIFFERENT Neo4j instance
# (different password) and a DIFFERENT LanceDB folder. Smoke scripts and the
# test suite call config.load_test_env() to swap those in. See
# src/knowledge_agent/config.py:load_test_env.

# Bolt endpoint. Standard for a single local Neo4j Desktop instance.
NEO4J_URI=neo4j://127.0.0.1:7687

# Database user. The Neo4j universal default is 'neo4j'.
NEO4J_USER=neo4j

# Password. You chose this at instance creation in Neo4j Desktop.
NEO4J_PASSWORD=


# ============================================================
# REQUIRED - LanceDB (embedded vector + BM25 store)
# ============================================================

# Folder where LanceDB stores its dataset files. Created on first use. No safe
# default. Recommended ./lance_data at the repo root (gitignored). Your
# .env.test should point at a SEPARATE folder (e.g. ./lance_data_test) so smoke
# runs cannot touch the real corpus's chunks.
LANCEDB_PATH=./lance_data


# ============================================================
# API keys (set only the providers you use)
# ============================================================
#
# No key is required at startup. The ACTIVE provider's key is validated lazily
# at first call, and no provider is privileged as always-required. With the
# default providers (anthropic for the LLM, voyage for embeddings) you set
# ANTHROPIC_API_KEY + VOYAGE_API_KEY. If you switch a provider below, set that
# provider's key instead. A mis-set provider raises a clear error naming the
# exact env var to fix.

# Anthropic (Claude family). Needed when LLM_PROVIDER=anthropic (the default).
ANTHROPIC_API_KEY=

# Voyage AI multimodal embeddings. Needed when EMBEDDING_PROVIDER=voyage
# (the default). The same embedding model must be set for ingest and query,
# or query vectors land in a different latent space from the indexed chunks.
VOYAGE_API_KEY=

# OpenAI. Needed only when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai.
#OPENAI_API_KEY=

# Google Generative AI (Gemini). Needed only when LLM_PROVIDER=google or
# EMBEDDING_PROVIDER=google.
#GOOGLE_API_KEY=


# ============================================================
# OPTIONAL - LLM / embedder provider selection
# ============================================================
#
# Two independent toggles; mix and match (e.g. Anthropic LLM + OpenAI
# embeddings is valid). NO AUTO-INSTALL: setting these is a SETTINGS CHANGE
# only. The GUI install dialog is what pip-installs a provider's adapter
# package. If you select a provider here but its adapter is not installed, the
# factory raises a clear ImportError on first use pointing at the install
# button.

# LLM provider. Options:
#   anthropic - Claude family (default)
#   openai    - GPT family
#   google    - Gemini family
#   ollama    - Local models via the Ollama daemon (daemon itself from
#               https://ollama.com; not pip-installable)
#LLM_PROVIDER=anthropic

# Embedding provider. Options:
#   voyage      - Voyage AI multimodal (default)
#   openai      - OpenAI text-embedding-3-*
#   google      - Google text-embedding-004
#   huggingface - Local model via sentence-transformers + torch
#                 (~2-3 GB for libs, plus 90 MB to 2.3 GB for the model)
#
# CAVEAT: switching to a provider whose embedding dimension differs from your
# existing corpus REQUIRES wiping LanceDB and re-ingesting (the dimension is
# pinned at chunks-table creation). The embedder lifecycle surfaces this as a
# destructive switch.
#EMBEDDING_PROVIDER=voyage

# Ollama daemon endpoint. Only consulted when LLM_PROVIDER=ollama. Default
# targets a local install on the standard port; override for a remote daemon.
#OLLAMA_BASE_URL=http://localhost:11434


# ============================================================
# OPTIONAL - Embedding model per provider
# ============================================================
#
# Each provider has its own model field. The active provider's model + its
# fixed dimension must stay consistent across ingest and query for one corpus.

# Voyage model (active when EMBEDDING_PROVIDER=voyage). Multimodal-capable so
# adding figures later does not force a full re-embed.
#EMBEDDING_MODEL=voyage-multimodal-3

# Voyage vector dimension. FIXED by the model (voyage-multimodal-3 = 1024).
# Changing it requires re-embedding the corpus.
#EMBEDDING_DIMS=1024

# OpenAI embedding model (active when EMBEDDING_PROVIDER=openai). 1536-dim.
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google embedding model (active when EMBEDDING_PROVIDER=google). 768-dim.
#GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# HuggingFace local model (active when EMBEDDING_PROVIDER=huggingface).
# Default BAAI/bge-m3 is multilingual, 1024-dim (~2.3 GB). Curated menu lives
# in embedder_lifecycle.py; picking one in the GUI updates this field AND
# triggers the model download. A manual edit here skips that download, so
# download the model first in the Installs tab.
#HF_EMBEDDING_MODEL=BAAI/bge-m3


# ============================================================
# OPTIONAL - Agent retrieval mode
# ============================================================

# Agent-level retrieval topology. Picks which store(s) get queried.
# Per-invocation override lives on the graph state's retrieval_mode field.
#   lancedb_only       - LanceDB hybrid search only
#   neo4j_only         - Cypher traversal in Neo4j only
#   lancedb_then_neo4j - LanceDB hits, then Neo4j enrichment
#   neo4j_then_lancedb - Neo4j filter, then LanceDB within scope
#   parallel_fused     - both fire in parallel, results fused
#   auto               - an LLM router picks one per query (default)
#DEFAULT_RETRIEVAL_MODE=auto


# ============================================================
# OPTIONAL - LLM agent nodes (models + temperatures)
# ============================================================
#
# The agent's four LLM call sites. Model defaults shown are for the anthropic
# provider; switching LLM_PROVIDER swaps in that provider's defaults.

# Mode classifier (auto mode only). A cheap, fast model: classifying into one
# of the retrieval modes is a small repeated task.
#MODE_CLASSIFIER_MODEL=claude-haiku-4-5

# Query builder: rewrites the question into search keywords. Cheap + fast.
#QUERY_BUILDER_MODEL=claude-haiku-4-5

# Cypher builder: writes Cypher from natural language against the KG schema.
# Uses a stronger model than the two above; Cypher needs compositional
# reasoning.
#CYPHER_BUILDER_MODEL=claude-sonnet-4-6

# Synthesizer: writes the final cited answer.
#SYNTHESIZER_MODEL=claude-sonnet-4-6

# Temperatures. 0.0 is recommended for all four (structured Pydantic output
# enforcement is strongest at temperature 0).
#MODE_CLASSIFIER_TEMPERATURE=0.0
#QUERY_BUILDER_TEMPERATURE=0.0
#CYPHER_BUILDER_TEMPERATURE=0.0
#SYNTHESIZER_TEMPERATURE=0.0

# Skip the query-rewrite LLM call. The question goes straight to search.
#SKIP_QUERY_BUILDER=false

# Skip the synthesizer LLM call. The agent returns the raw retriever output
# (chunks and/or graph rows) as sources, with an empty answer field.
#DIRECT_RETRIEVAL=false


# ============================================================
# OPTIONAL - Rate limiting, retries, concurrency
# ============================================================
#
# Per-provider request-rate caps in requests/sec. Blank (None) disables the
# limiter. The anthropic/openai/google/ollama caps throttle LLM (chat) calls
# only; voyage is the one embedder with a cap (applied around its native
# client). Wire each to your tier's documented limit.
#ANTHROPIC_REQUESTS_PER_SECOND=
#OPENAI_REQUESTS_PER_SECOND=
#GOOGLE_REQUESTS_PER_SECOND=
#VOYAGE_REQUESTS_PER_SECOND=
#OLLAMA_REQUESTS_PER_SECOND=

# Max attempts (including the first) per LLM call, applied at the agent graph's
# LLM call sites with exponential jitter. Covers transient 429s + network blips.
#LLM_MAX_RETRIES=3

# Max chunks the ingest pipeline processes in parallel within one document
# (the per-chunk fan-out for L6 entity + L8 triples extraction). Higher = faster
# but more concurrent LLM calls (bumps against rate limits).
#PIPELINE_MAX_CONCURRENT_CHUNKS=8


# ============================================================
# OPTIONAL - LanceDB retrieval knobs
# ============================================================
#
# All query-time tunables. Changing any of these does NOT require re-ingest or
# re-embed. Constraint: TOP_K <= NUM_CANDIDATES (validated at config load).

# Number of chunks returned per query.
#TOP_K=5

# Mode WITHIN LanceDB: hybrid (BM25 + vector RRF-fused), fts (BM25 only), or
# vector (kNN cosine only).
#LANCEDB_SEARCH_MODE=hybrid

# Candidate-pool size fetched before truncating/re-ranking to TOP_K. In hybrid
# mode each leg (BM25 + vector) retrieves this many rows, RRF fuses them, and
# the result is cut (or MMR-reranked) to TOP_K.
#NUM_CANDIDATES=100

# RRF rank constant k in 1/(k + rank). Standard value is 60.
#RRF_RANK_CONSTANT=60

# MMR relevance/diversity tradeoff (0.0 = diversity, 1.0 = relevance).
#MMR_LAMBDA=0.6

# Default for the use_mmr flag. When true, hybrid/vector searches MMR-rerank the
# candidate pool for diversity. Ignored in fts mode (no vectors).
#DEFAULT_USE_MMR=false

# Minimum row count before the vector index is attempted. LanceDB's IVF_PQ needs
# ~256 rows to train; below this, brute-force scan handles vector search. The
# FTS index is always created.
#MIN_ROWS_FOR_VECTOR_INDEX=256


# ============================================================
# OPTIONAL - Neo4j retrieval + driver knobs
# ============================================================

# Maximum rows per Neo4j query. Enforced by wrapping the LLM's Cypher in
# CALL { ... } RETURN * LIMIT N, so the cap holds even if the LLM forgets LIMIT.
# Distinct from TOP_K (LanceDB-side); graph queries legitimately return more.
#KG_MAX_ROWS=50

# Max connections in the async driver's pool. Neo4j's default is 100, fine for a
# single-user desktop. Read once at driver construction; restart to change.
#NEO4J_MAX_CONNECTION_POOL_SIZE=100

# Seconds the driver waits for a free pooled connection before raising. 60s
# matches the Neo4j default; bump for slow networks or contention.
#NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60.0


# ============================================================
# OPTIONAL - Ontology downloads (L7)
# ============================================================

# Directory for downloaded ontology source files. Each enabled L7 ontology layer
# downloads its file here on first use and reuses the local copy afterward. Safe
# to delete (files re-download on next ingest). Defaults to a folder under the
# OS-standard cache dir; set this to override with a custom location.
#ONTOLOGY_DOWNLOADS_DIR=


# ============================================================
# OPTIONAL - OpenAlex resolution
# ============================================================

# Email for OpenAlex's polite pool (faster + more reliable DOI lookups). Lookups
# work without it, just rate-limited more aggressively.
#OPENALEX_MAILTO=you@example.com


# ============================================================
# OPTIONAL - HTTP client
# ============================================================
#
# Shared by every outbound call (OpenAlex, GitHub tree API, Ollama probe,
# ontology downloads). One place to tune timeout / retries / User-Agent.

# Default per-request timeout in seconds. Individual call sites can override
# (the Ollama probe uses 1s; ontology downloads stream unbounded).
#HTTP_DEFAULT_TIMEOUT=30.0

# Max retry attempts on retryable HTTP failures (429, 5xx, network). 0 disables.
# Streaming downloads never retry regardless (partial-replay is unsafe).
#HTTP_MAX_RETRIES=3

# User-Agent header on every outbound request. Some APIs (GitHub, OpenAlex)
# condition rate-limit pools on it; add a contact email if you ship this app.
#HTTP_USER_AGENT=knowledge-agent/0.x
