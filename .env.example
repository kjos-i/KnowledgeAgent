# Copy this file to .env and fill in real values.
# Never commit your real .env - it's listed in .gitignore.
#
# Required values are uncommented. Optional overrides are shown commented
# with their defaults; uncomment + edit only the ones you want to change.
# See config.py for the full Settings class, types, and field descriptions.


# ============================================================
# REQUIRED - API keys (default providers)
# ============================================================
#
# Default provider keys are required (Anthropic for LLM, Voyage for
# embeddings) - they're the always-installed providers used when no
# alternative is selected via LLM_PROVIDER / EMBEDDING_PROVIDER below.
# Add-on providers (OpenAI, Google, Ollama, HuggingFace) are LAZY-
# validated: their keys are only required IF you switch to them.

# Chat LLM (query builder + synthesizer nodes).
ANTHROPIC_API_KEY=

# Embedding model (multimodal). Used at ingest AND query time - the same
# model must be set for both, or query vectors land in a different latent
# space from the indexed chunks.
VOYAGE_API_KEY=


# ============================================================
# OPTIONAL - Alternative LLM / embedder provider selection
# ============================================================
#
# Two independent toggles; mix and match (e.g. Anthropic LLM +
# OpenAI embeddings is a valid pairing). NO AUTO-INSTALL: setting
# these env vars is a SETTINGS CHANGE only. The GUI's install dialog
# is the path that pip-installs the provider's adapter package; if
# you set a provider here but its adapter isn't installed, the
# factory raises a clear ImportError on first use pointing at the
# install button.

# LLM provider. Options:
#   anthropic - Claude family (bundled default, ANTHROPIC_API_KEY)
#   openai    - GPT family (install via GUI -> Settings -> LLM Provider)
#   google    - Gemini family (install via GUI)
#   ollama    - Local models via Ollama daemon (install via GUI;
#               daemon itself from https://ollama.com)
#LLM_PROVIDER=anthropic

# Embedding provider. Options:
#   voyage      - Voyage AI multimodal (bundled default, VOYAGE_API_KEY)
#   openai      - OpenAI text-embedding-3-* (install via GUI)
#   google      - Google text-embedding-004 (install via GUI)
#   huggingface - Local model via sentence-transformers + torch
#                 (install via GUI; ~2-3 GB for libs, plus 90 MB -
#                 2.3 GB for the chosen model)
#
# CAVEAT: changing embedding provider with a different dimension
# than your existing corpus REQUIRES wiping LanceDB + re-ingesting
# (dimension is pinned at chunks-table creation). The
# embedder_lifecycle.switch_embedder_plan call surfaces this as a
# destructive switch.
#EMBEDDING_PROVIDER=voyage

# Add-on provider API keys. Set ONLY the ones for providers you
# actually use - all default to None and are validated lazily at
# first call. Mis-set provider raises a clear ConfigError naming
# the exact env var to fix.
#OPENAI_API_KEY=
#GOOGLE_API_KEY=

# Ollama daemon endpoint. Only consulted when LLM_PROVIDER=ollama.
# Default targets a local install on the standard port; override
# for a remote daemon.
#OLLAMA_BASE_URL=http://localhost:11434


# ============================================================
# REQUIRED - Knowledge graph (Neo4j)
# ============================================================
#
# ALL FOUR DB settings (NEO4J_URI / NEO4J_USER / NEO4J_PASSWORD /
# LANCEDB_PATH) are REQUIRED - no safe defaults. Forcing explicit
# values eliminates the "forgot to set it, silently used the default,
# wrote to the wrong place" failure mode.
#
# Test-instance isolation pattern: keep a parallel `.env.test` file
# alongside this `.env` (same folder). `.env.test` declares the SAME
# four required keys but points at a DIFFERENT Neo4j Desktop instance
# (different password) and a DIFFERENT LanceDB folder
# (e.g. ./lance_data_test). Smoke scripts call `config.load_test_env()`
# at the top to swap in those values. See:
#   src/knowledge_agent/config.py:load_test_env

# Bolt endpoint. Standard for a single local Neo4j Desktop instance.
NEO4J_URI=neo4j://127.0.0.1:7687

# Database user. The Neo4j universal default is 'neo4j'.
NEO4J_USER=neo4j

# Password - you chose this at instance creation in Neo4j Desktop.
NEO4J_PASSWORD=


# ============================================================
# REQUIRED - LanceDB (embedded vector + BM25 store)
# ============================================================

# Folder where LanceDB stores its dataset files. Created on first use.
# Recommended: `./lance_data` at the repo root (gitignored). Your
# `.env.test` should point at a SEPARATE folder (e.g. `./lance_data_test`)
# so smoke runs cannot touch the real corpus's chunks.
LANCEDB_PATH=./lance_data


# ============================================================
# OPTIONAL - Embedding model knobs
# ============================================================

# Voyage embedding model. Multimodal-capable so adding figures later
# won't force a full re-embed.
#EMBEDDING_MODEL=voyage-multimodal-3

# Embedding vector dimension. FIXED by the model
# (voyage-multimodal-3 = 1024). Changing requires re-embedding the corpus.
#EMBEDDING_DIMS=1024


# ============================================================
# OPTIONAL - OpenAlex resolution
# ============================================================

# Email for OpenAlex's polite pool (faster + more reliable DOI lookups).
# Lookups work without it, just rate-limited more aggressively.
#OPENALEX_MAILTO=you@example.com


# ============================================================
# OPTIONAL - Agent retrieval mode
# ============================================================

# Agent-level retrieval topology. Picks which store(s) get queried.
# Per-invocation override lives on the graph state's retrieval_mode field.
#   lancedb_only       - LanceDB hybrid search only (PHASE 1, default)
#   neo4j_only         - Cypher traversal in Neo4j only (PHASE 2)
#   lancedb_then_neo4j - LanceDB hits, then Neo4j enrichment (PHASE 3)
#   neo4j_then_lancedb - Neo4j filter, then LanceDB within scope (PHASE 3)
#   parallel_fused     - both fire in parallel, results fused (PHASE 4)
#   auto               - LLM router picks one of 1-5 per query (PHASE 5)
#DEFAULT_RETRIEVAL_MODE=lancedb_only


# ============================================================
# OPTIONAL - LanceDB retrieval knobs
# ============================================================
#
# All query-time tunables - changing any of these does NOT require
# re-ingest or re-embed. Constraint:
#     top_k <= num_candidates
# Pydantic validates this at config-load time.

# Number of chunks returned per query.
#TOP_K=5

# Within-LanceDB mode: hybrid (BM25 + vector RRF-fused), fts (BM25 only),
# or vector (kNN cosine only).
#LANCEDB_SEARCH_MODE=hybrid

# Candidate-pool size fetched before truncating/re-ranking to top_k.
# In hybrid mode each leg (BM25 + vector) retrieves this many rows, RRF
# fuses them, and the result is cut (or MMR-reranked) to top_k.
#NUM_CANDIDATES=100

# RRF rank constant `k` in 1/(k + rank). Standard value is 60.
#RRF_RANK_CONSTANT=60

# MMR relevance/diversity tradeoff (0.0=diversity, 1.0=relevance).
#MMR_LAMBDA=0.6

# Per-ingest index optimization. When True (default), every ingest_document
# call folds new chunks into the vector + FTS indexes incrementally so
# search stays fast and always sees fresh rows. Turn off for bulk loads
# where you defer indexing to one optimize at the end.
#OPTIMIZE_INDEXES_PER_INGEST=true

# Minimum row count before the vector index is attempted. LanceDB's default
# IVF_PQ needs ~256 rows to train. Below this, brute force scan handles
# vector search (fast at small scale). FTS index is always created.
#MIN_ROWS_FOR_VECTOR_INDEX=256


# ============================================================
# OPTIONAL - Neo4j retrieval knobs
# ============================================================

# Maximum rows per Neo4j query. Enforced by wrapping the LLM's Cypher in
# CALL { ... } RETURN * LIMIT N, so the cap holds even if the LLM forgets
# LIMIT. Distinct from TOP_K (which is LanceDB-side, smaller default) -
# graph queries legitimately return more rows.
#KG_MAX_ROWS=50


# ============================================================
# OPTIONAL - LLM nodes (mode classifier + query builders + synthesizer)
# ============================================================

# Cheap Haiku call for classifying the user's question into one of the 5
# concrete retrieval modes. Only runs when retrieval_mode = "auto".
#MODE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Cheap Haiku call for rewriting the user's question into search keywords
# (used in lancedb_only and cross-store modes).
#QUERY_BUILDER_MODEL=claude-haiku-4-5-20251001

# Sonnet for writing Cypher from natural language against the KG schema
# (used in neo4j_only and cross-store modes). Sonnet, not Haiku - Cypher
# composition needs more compositional reasoning.
#CYPHER_BUILDER_MODEL=claude-sonnet-4-6

# Sonnet for synthesizing the final answer with citations.
#SYNTHESIZER_MODEL=claude-sonnet-4-6

# Temperatures - 0.0 is recommended for all four (structured Pydantic
# output enforcement is strongest at temperature 0).
#MODE_CLASSIFIER_TEMPERATURE=0.0
#QUERY_BUILDER_TEMPERATURE=0.0
#CYPHER_BUILDER_TEMPERATURE=0.0
#SYNTHESIZER_TEMPERATURE=0.0

# Skip the query-rewrite LLM call. User's question goes straight to search.
#SKIP_QUERY_BUILDER=false

# Skip the synthesizer LLM call. Agent returns the raw retriever output
# (chunks and/or graph rows) as sources, with an empty answer field.
#DIRECT_RETRIEVAL=false


# ============================================================
# OPTIONAL - Parsing (docling)
# ============================================================

# OCR for PDF inputs. Default off - research papers are usually
# born-digital. Turn on for scanned PDFs.
#ENABLE_PDF_OCR=false

# OCR for standalone image-format inputs (PNG/JPG/TIFF). Default on -
# without OCR, image-only inputs produce no searchable text.
#ENABLE_IMAGE_OCR=true

# Chunker strategy:
#   hybrid       - structure-aware + token-aware (default, recommended)
#   hierarchical - structure-only, no token cap (chunks can be large)
#CHUNKER_STRATEGY=hybrid

# Max tokens per chunk (HybridChunker only - ignored by Hierarchical).
# Higher = broader context per chunk, fewer chunks, more storage per
# chunk. Changing requires re-chunking + re-embedding existing docs.
#CHUNK_MAX_TOKENS=512
